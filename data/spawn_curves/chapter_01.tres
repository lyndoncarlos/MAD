[gd_resource type="Resource" script_class="SpawnCurveData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/data/spawn_curve_data.gd" id="1_curve"]
[ext_resource type="Script" path="res://scripts/data/spawn_wave.gd" id="2_wave"]

[sub_resource type="Resource" id="Resource_wave_a"]
script = ExtResource("2_wave")
start_minute = 0.0
end_minute = 4.0
enemy_id = &"tiyanak"
spawns_per_second = 1.0
max_alive = 40

[sub_resource type="Resource" id="Resource_wave_b"]
script = ExtResource("2_wave")
start_minute = 4.0
end_minute = 10.0
enemy_id = &"tiyanak"
spawns_per_second = 2.5
max_alive = 120

[resource]
script = ExtResource("1_curve")
duration_minutes = 20.0
waves = Array[ExtResource("2_wave")]([SubResource("Resource_wave_a"), SubResource("Resource_wave_b")])
id = &"chapter_01"
display_name = "Chapter 1 spawn curve (placeholder)"
schema_version = 1
source = ""
notes = "Two placeholder waves. Real curve is built in M2."
